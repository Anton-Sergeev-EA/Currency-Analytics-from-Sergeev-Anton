# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Every field here maps 1:1 to src/core/config.py's Settings class - that
# module is the single source of truth for what the app actually reads;
# this file exists so `cp .env.example .env` (as the README's Quick Start
# has always said to run) doesn't fail because the file doesn't exist.

# --- App metadata ---
APP_VERSION=1.0.0
DEBUG=False

# --- Server ---
HOST=0.0.0.0
PORT=8002

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Security: change both before any real deployment ---
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# --- External data source ---
CBR_API_URL=https://www.cbr.ru/scripts/XML_daily.asp

# --- Paths ---
DATA_PATH=./data
DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=INFO

# --- Public domain / CORS ---
# The domain this instance is reachable at (used by nginx.conf and the
# Let's Encrypt bootstrap script, scripts/init_letsencrypt.sh - not read
# by the Python app itself, which instead reads ALLOWED_ORIGINS below).
DOMAIN=anton-analytics.ru
# Comma-separated list of origins allowed to call the API cross-origin.
ALLOWED_ORIGINS=https://anton-analytics.ru,https://www.anton-analytics.ru,http://localhost:8002,http://127.0.0.1:8002

# --- Ollama (local LLM for the RAG assistant) ---
USE_OLLAMA=True
OLLAMA_BASE_URL=http://172.17.0.1:11434
OLLAMA_MODEL=tinyllama

# --- OpenAI-compatible LLM (optional alternative to Ollama) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=tinyllama
LLM_ENABLED=True

# --- MLflow experiment tracking (optional) ---
# Points train_models.py at an MLflow tracking server - NOT bundled with
# this repo or this docker-compose.yml; it's expected to already be
# running (e.g. as its own systemd service on the VDS). Leave blank to
# disable logging entirely - training itself never fails because of this.
MLFLOW_TRACKING_URI=http://172.17.0.1:5000
MLFLOW_EXPERIMENT_NAME=currency-forecast

# --- Deployment tuning (used by docker-compose.yml / docker-compose.prod.yml,
# not read by the Python app itself) - see the "Deploying on a small VDS"
# section of the README for context. Defaults are already tuned for a
# 4GB-RAM VDS; only raise these if `free -h` shows real headroom.
UVICORN_WORKERS=1
REPLICAS=1
