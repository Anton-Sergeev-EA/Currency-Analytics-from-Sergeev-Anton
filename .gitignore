# Секреты и конфиги
.env
.env.*
# .env.* above would also swallow the tracked, secret-free .env.example
# template (README's Quick Start has always said to `cp .env.example
# .env`, but the file itself was never committed - see .env.example).
!.env.example
# *.env (not just .env/.env.*) also catches production.env, which
# holds the real deployment secrets and was previously listed
# explicitly for exactly that reason -- broadened so a differently
# named env file (staging.env, local.env, ...) doesn't slip through.
*.env
deploy.sh
*.key
*.pem
*.crt
*.p12
*.jks
*.keystore
*secret*
*password*
*credential*
*private*

# Логи и данные
logs/
*.log
/data/
*.db
*.sqlite

# Модели
/models/
*.joblib
*.pkl
*.h5
*.pt
*.pth

# Временные файлы
__pycache__/
*.pyc
*.pyo
*.tmp
*.swp
.idea/
.vscode/
.DS_Store

# Бэкапы
*.bak
*.bak2
*.save
*.backup

# Python virtual environments
.venv/
venv/
venv312/
env/
ENV/
